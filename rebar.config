{erl_opts, [debug_info, warn_export_all, warn_unused_import, warn_unused_vars]}.

{deps, [
  {cowboy, "2.10.0"},
  {jsx,    "3.1.0"}
]}.

%% Compile Diameter .dia dictionary sources in priv/dict/ into
%% .erl/.hrl in apps/epdg/src before normal Erlang compilation.
%% Uses diameter_make from OTP — no external plugin required.
{pre_hooks, [
  {compile, "./scripts/compile-diameter-dicts.sh"}
]}.

{relx, [
  {release, {epdg, "0.0.57"}, [epdg, diameter, sasl]},
  {dev_mode, true},
  {include_erts, false}
]}.

{profiles, [
  {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}
]}.
