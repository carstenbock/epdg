[
 %% All ePDG configuration is read from environment variables.
 %% See epdg_config.erl for the complete list of supported env vars.
 %%
 %% DPD tunables (env vars, defaults shown):
 %%   EPDG_DPD_INTERVAL=120000      DPD probe interval (ms)
 %%   EPDG_DPD_TIMEOUT=10000        DPD response timeout per probe (ms)
 %%   EPDG_DPD_RETRIES=3            Max consecutive missed probes
 {kernel, [
   %% Hard deadline on `init:stop/0'. After this many milliseconds the
   %% application controller brutally kills any application that has
   %% not stopped on its own. Keeps total post-SIGTERM teardown within
   %% the K8s 30 s buffer between preStop completion and SIGKILL (see
   %% epdg-chart statefulset terminationGracePeriodSeconds). Default
   %% is `infinity', which lets a single stuck cowboy keep-alive or
   %% diameter transport hang the BEAM forever.
   {shutdown_timeout, 20000}
 ]},
 {sasl, [{sasl_error_logger, false}]}
].
