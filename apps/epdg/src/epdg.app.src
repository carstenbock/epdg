{application, epdg,
 [{description, "Evolved Packet Data Gateway (ePDG) for VoWiFi - Native Erlang IKEv2 with kernel XFRM data plane"},
 {vsn, "0.0.74"},
  {modules, [epdg_app, epdg_sup, epdg_config,
             epdg_ikev2_listener, epdg_ikev2_crypto, epdg_ikev2_codec,
             epdg_ue_sup, epdg_ue_fsm, epdg_ue_registry,
             epdg_xfrm, epdg_gtpc_client, epdg_gtpc_codec, epdg_tft,
             epdg_dns_cache, epdg_gtpu_forwarder,
             epdg_diameter_swm, diameter_gen_swm,
             epdg_metrics, epdg_http, epdg_http_handler]},
  {registered, [epdg_sup, epdg_ue_registry, epdg_ikev2_listener,
                epdg_xfrm, epdg_gtpc_client, epdg_dns_cache,
                epdg_gtpu_forwarder, epdg_metrics]},
  {applications, [kernel, stdlib, sasl, crypto, ssl, diameter, cowboy, jsx]},
  {mod, {epdg_app, []}}]}.
